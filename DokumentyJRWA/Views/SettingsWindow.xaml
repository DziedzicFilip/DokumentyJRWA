<Controls:MetroWindow x:Class="DokumentyJRWA.Views.SettingsWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="Ustawienia" 
                      Height="550" 
                      Width="600"
                      WindowStartupLocation="CenterOwner"
                      ResizeMode="NoResize">

    <Controls:MetroWindow.Resources>
        <StreamGeometry x:Key="Icon.Folder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Import">M14,12L10,8V11H2V13H10V16M20,18V6C20,4.89 19.1,4 18,4H6A2,2 0 0,0 4,6V9H6V6H18V18H6V15H4V18A2,2 0 0,0 6,20H18A2,2 0 0,0 20,18Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Export">M23,12L19,8V11H10V13H19V16M1,18V6C1,4.89 1.89,4 3,4H15A2,2 0 0,1 17,6V9H15V6H3V18H15V15H17V18A2,2 0 0,1 15,20H3A2,2 0 0,1 1,18Z</StreamGeometry>
    </Controls:MetroWindow.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0" 
                   Text="Konfiguracja aplikacji" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#333"/>

        <!-- Sekcja 1: Główny folder dokumentów -->
        <GroupBox Grid.Row="2" Header="Główny folder dokumentów">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Wybierz folder, w którym będą tworzone katalogi zgodnie ze strukturą JRWA:"
                           TextWrapping="Wrap"
                           Foreground="#666"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                   <TextBox Grid.Column="0"
         Text="{Binding MainFolderPath, UpdateSourceTrigger=PropertyChanged}"
         Controls:TextBoxHelper.Watermark="Np. D:\Dokumenty\JRWA"
         ToolTip="Wpisz ścieżkę ręcznie lub kliknij Przeglądaj"/>

                    <Button Grid.Column="2"
                            Command="{Binding BrowseMainFolderCommand}"
                            Content="Przeglądaj"
                            MinWidth="100"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Sekcja 2: Import/Export JRWA -->
        <GroupBox Grid.Row="4" Header="Struktura katalogów JRWA">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Aktualny plik JRWA:"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Row="2"
                         Text="{Binding JrwaFilePath, Mode=OneWay}"
                         Controls:TextBoxHelper.Watermark="Brak załadowanego pliku JRWA"
                         IsReadOnly="True"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding ImportJrwaCommand}"
                            MinWidth="150"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" 
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                  Stretch="Uniform" 
                                  Width="14" 
                                  Height="14"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Importuj JRWA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportJrwaCommand}"
                            MinWidth="150">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Export}" 
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                  Stretch="Uniform" 
                                  Width="14" 
                                  Height="14"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Eksportuj JRWA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Przyciski akcji -->
        <StackPanel Grid.Row="6" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Zapisz" 
                    Command="{Binding SaveCommand}"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"/>
            <Button Content="Anuluj" 
                    Command="{Binding CancelCommand}"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>