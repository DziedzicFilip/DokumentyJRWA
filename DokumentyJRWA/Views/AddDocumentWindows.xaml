<Window x:Class="DokumentyJRWA.Views.AddDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj dokument" Height="400" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tytuł label -->
            <RowDefinition Height="Auto"/> <!-- Tytuł textbox -->
            <RowDefinition Height="Auto"/> <!-- Data wpływu label -->
            <RowDefinition Height="Auto"/> <!-- Data wpływu picker -->
            <RowDefinition Height="Auto"/> <!-- JRWA label -->
            <RowDefinition Height="Auto"/> <!-- JRWA textbox -->
            <RowDefinition Height="Auto"/> <!-- Podmioty label -->
            <RowDefinition Height="Auto"/> <!-- Podmioty textbox -->
            <RowDefinition Height="Auto"/> <!-- Plik -->
            <RowDefinition Height="Auto"/> <!-- Dodaj button -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Tytuł" Grid.Row="0" Margin="0,5"/>
        <TextBox Grid.Row="1" Margin="0,5" Text="{Binding Tytul, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Data wpływu" Grid.Row="2" Margin="0,5"/>
        <DatePicker Grid.Row="3" Margin="0,5" SelectedDate="{Binding DataWplywu, Mode=TwoWay}" />

        <TextBlock Text="JRWA CODE" Grid.Row="4" Margin="0,5"/>
<ComboBox Grid.Row="5" 
          Margin="0,5" 
          ItemsSource="{Binding AvailableJrwaCodes}"
          Text="{Binding JrwaCode, UpdateSourceTrigger=PropertyChanged}"
          IsEditable="True"
          ToolTip="Wybierz z listy lub wpisz kod JRWA ręcznie"/>

        <TextBlock Text="Podmioty" Grid.Row="6" Margin="0,5"/>
        <TextBox Grid.Row="7" Margin="0,5" Text="{Binding Podmioty, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,5">
            <TextBox Width="200" Text="{Binding FilePath, Mode=TwoWay}" IsReadOnly="True"/>
            <Button Content="Wybierz plik" Command="{Binding ChooseFileCommand}" Margin="5,0"/>
        </StackPanel>

        <Button Grid.Row="9" Content="Dodaj" IsDefault="True"
                Click="Add_Click" Margin="0,10,0,0"
                HorizontalAlignment="Right" Width="100"/>
    </Grid>
</Window>