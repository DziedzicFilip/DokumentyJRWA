<Controls:MetroWindow x:Class="DokumentyJRWA.Views.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="Dokumenty JRWA" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Menu -->
            <ColumnDefinition Width="*"/>
            <!-- Główna zawartość -->
        </Grid.ColumnDefinitions>

        <!-- Boczne menu -->
        <Controls:HamburgerMenu Grid.Column="0"
                                PaneBackground="LightGray"
                                DisplayMode="CompactInline">
            <Controls:HamburgerMenu.ItemsSource>
                <Controls:HamburgerMenuItemCollection>
                    <Controls:HamburgerMenuIconItem Icon="{DynamicResource MahApps.Icons.Plus}" Label="Dodaj dokument"/>
                    <Controls:HamburgerMenuIconItem Icon="{DynamicResource MahApps.Icons.FolderOpen}" Label="Architektura JRWA"/>
                </Controls:HamburgerMenuItemCollection>
            </Controls:HamburgerMenu.ItemsSource>

            <!-- Content menu musi być zdefiniowane -->
            <Controls:HamburgerMenu.Content>
                <TextBlock Text="Wybierz opcję z menu" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Controls:HamburgerMenu.Content>
        </Controls:HamburgerMenu>

        <!-- Główna część z filtrem i listą dokumentów -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Width="300" Margin="0,0,0,10"
                     Controls:TextBoxHelper.Watermark="Filtruj dokumenty..."
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredDokumenty}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tytuł" Binding="{Binding Tytul}" />
                    <DataGridTextColumn Header="Data wpływu" Binding="{Binding DataWplywu}" />
                    <DataGridTextColumn Header="JRWA" Binding="{Binding JrwaCode}" />
                    <DataGridTextColumn Header="Podmioty" Binding="{Binding Podmioty}" />
                    <DataGridTemplateColumn Header="Akcje">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edycja" Margin="0,0,5,0" 
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Usuń" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Controls:MetroWindow>
