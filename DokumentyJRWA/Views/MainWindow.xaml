<Controls:MetroWindow x:Class="DokumentyJRWA.Views.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="Dokumenty JRWA" Height="450" Width="800">

    <Controls:MetroWindow.Resources>
        <StreamGeometry x:Key="Icon.Plus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Folder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
    </Controls:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="#f0f0f0" BorderBrush="#cccccc" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo -->
                    <RowDefinition Height="40"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Add File -->
                    <RowDefinition Height="20"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Export/Import -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo Placeholder -->
                <Border Grid.Row="0" Height="60" Width="170" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="White" HorizontalAlignment="Left">
                    <TextBlock Text="LOGO" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                </Border>

                <!-- Add File Section -->
                <Grid Grid.Row="2" Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Button -->
                        <ColumnDefinition Width="*"/>    <!-- Text -->
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                            Command="{Binding AddFileCommand}" 
                            Height="40" 
                            Width="40" 
                            HorizontalAlignment="Left"
                            ToolTip="Dodaj nowy plik"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}">
                        <Path Data="{StaticResource Icon.Plus}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    
                    <TextBlock Grid.Column="1" 
                               Text="Dodaj nowy plik" 
                               FontWeight="SemiBold" 
                               Foreground="#333" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- Export/Import Section -->
                <Grid Grid.Row="4" Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Button -->
                        <ColumnDefinition Width="*"/>    <!-- Text -->
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ExportImportArchitectureCommand}" 
                            Height="40" 
                            Width="40" 
                            HorizontalAlignment="Left"
                            ToolTip="Export/Import Architektury JWRA"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}">
                        <Path Data="{StaticResource Icon.Folder}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    
                    <TextBlock Grid.Column="1" 
                               Text="Export/Import Architektury JWRA" 
                               FontWeight="SemiBold" 
                               Foreground="#333" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0" 
                               TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Width="300" Margin="0,0,0,10"
                     Controls:TextBoxHelper.Watermark="Filtruj dokumenty..."
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredDokumenty}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tytuł" Binding="{Binding Tytul}" />
                    <DataGridTextColumn Header="Data wpływu" Binding="{Binding DataWplywu}" />
                    <DataGridTextColumn Header="JRWA" Binding="{Binding JrwaCode}" />
                    <DataGridTextColumn Header="Podmioty" Binding="{Binding Podmioty}" />
                    <DataGridTemplateColumn Header="Akcje">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edycja" Margin="0,0,5,0" 
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Usuń" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Controls:MetroWindow>
