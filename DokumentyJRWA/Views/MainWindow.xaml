<Controls:MetroWindow x:Class="DokumentyJRWA.Views.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      Title="Dokumenty JRWA" Height="450" Width="800">

    <Controls:MetroWindow.Resources>
        <StreamGeometry x:Key="Icon.Plus">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
   <StreamGeometry x:Key="Icon.Settings">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry></Controls:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="#f0f0f0" BorderBrush="#cccccc" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo -->
                    <RowDefinition Height="40"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Add File -->
                    <RowDefinition Height="20"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Export/Import -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo Placeholder -->
                <Border Grid.Row="0" Height="60" Width="170" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="White" HorizontalAlignment="Left">
                    <TextBlock Text="LOGO" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" FontWeight="Bold"/>
                </Border>

                <!-- Add File Section -->
                <Grid Grid.Row="2" Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Button -->
                        <ColumnDefinition Width="*"/>    <!-- Text -->
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                            Command="{Binding AddFileCommand}" 
                            Height="40" 
                            Width="40" 
                            HorizontalAlignment="Left"
                            ToolTip="Dodaj nowy plik"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}">
                        <Path Data="{StaticResource Icon.Plus}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    
                    <TextBlock Grid.Column="1" 
                               Text="Dodaj nowy plik" 
                               FontWeight="SemiBold" 
                               Foreground="#333" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                </Grid>

                <!-- Export/Import Section -->
                <Grid Grid.Row="4" Margin="0,5,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Button -->
                        <ColumnDefinition Width="*"/>    <!-- Text -->
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ExportImportArchitectureCommand}" 
                            Height="40" 
                            Width="40" 
                            HorizontalAlignment="Left"
                            ToolTip="Export/Import Architektury JWRA"
                            Style="{DynamicResource MahApps.Styles.Button.Circle}">
                        <Path Data="{StaticResource Icon.Settings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="16" Height="16"/>
                    </Button>
                    
                    <TextBlock Grid.Column="1" 
                               Text="Ustawienia" 
                               FontWeight="SemiBold" 
                               Foreground="#333" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0" 
                               TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Width="300" Margin="0,0,0,10"
                     Controls:TextBoxHelper.Watermark="Filtruj dokumenty..."
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredDokumenty}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tytuł" Binding="{Binding Tytul}" />
                    <DataGridTextColumn Header="Data wpływu" Binding="{Binding DataWplywu}" />
                    <DataGridTextColumn Header="JRWA" Binding="{Binding JrwaCode}" />
                    <DataGridTextColumn Header="Podmioty" Binding="{Binding Podmioty}" />
                    <DataGridTemplateColumn Header="Akcje">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edycja" Margin="0,0,5,0" 
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Usuń" 
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Controls:MetroWindow>
